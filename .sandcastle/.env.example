# Copy to .sandcastle/.env (gitignored). Only keys listed here are forwarded into the sandbox.
# Empty values fall back to the same variable in your host environment.

# --- Claude Code auth (exactly one of the two) ---
# OAuth token for your Claude subscription: run `claude setup-token` on your host and paste it.
CLAUDE_CODE_OAUTH_TOKEN=
# ...or an Anthropic API key (pay per token, https://console.anthropic.com/settings/keys):
# ANTHROPIC_API_KEY=

# --- GitHub: issue queue, git push and pull requests from inside the sandbox ---
GITHUB_REPO=molntamas/imigraph
# Fine-grained personal access token, https://github.com/settings/personal-access-tokens/new
#   Repository access: Only select repositories -> imigraph
#   Repository permissions: Contents, Issues, Pull requests = Read and write (Metadata: Read, automatic)
GH_TOKEN=
# Comma-separated GitHub logins whose issues and comments agents act on (default: the repo owner).
# The repository is public, so issues and comments from anyone else are ignored.
# GITHUB_TRUSTED_USERS=molntamas

# --- optional ---
# Model passed to Claude Code (default: claude-sonnet-5-5). Aliases like "sonnet"/"opus" work too.
# SANDCASTLE_MODEL=claude-sonnet-5-5
